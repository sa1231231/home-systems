# Port the HTTP server binds to. Railway injects PORT automatically; defaults to 3000 locally.
PORT=3000

# Postgres connection string.
# - On Railway: set as ${{Postgres.DATABASE_URL}} (private network, *.railway.internal).
# - Locally: copy the Postgres "Public Networking" URL from Railway → Postgres service → Variables
#   (DATABASE_PUBLIC_URL). Required for `npm run db:push` from your laptop.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Anthropic API key. Optional locally — the /ai-calls endpoints and the
# classify() wrapper return / throw `MissingAnthropicKeyError` (HTTP 503)
# until set. Required for any Tier 3 classification.
ANTHROPIC_API_KEY=

# Google OAuth + CRM Sheet (Phase 1b).
# All four are optional locally — endpoints under /contacts return 503 until
# they're set. See docs/development.md → "Google OAuth one-time setup" for
# how to obtain GOOGLE_OAUTH_REFRESH_TOKEN via `npm run auth:google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
CRM_SHEET_ID=

# Additional Gmail accounts to triage, beyond GOOGLE_OAUTH_REFRESH_TOKEN.
# JSON array of OAuth refresh tokens — run `npm run auth:google` once per
# account (different Google login each time) to obtain them. Email triage
# runs across the primary token plus every token listed here.
# Example: GMAIL_ACCOUNTS=["1//token-a","1//token-b"]
GMAIL_ACCOUNTS=

# Nightly contacts sync (Google Contacts → CRM Sheet).
# Default schedule is 7am UTC = 3am ET. Set ENABLED=true in Railway to turn
# on; leave unset locally so dev doesn't fire at 3am. Schedule uses standard
# 5-field cron syntax in UTC.
CONTACTS_SYNC_CRON_ENABLED=
CONTACTS_SYNC_CRON_SCHEDULE=

# Daily Gmail triage. Each run scans every inbox email from the last 72h
# (skipping promotions/social), across all accounts, matching rules first
# and falling through to AI classification for the residual. Default 7am UTC.
EMAIL_TRIAGE_CRON_ENABLED=
EMAIL_TRIAGE_CRON_SCHEDULE=

# Transaction categorization. The Sheet is read by the Transactions tab (each
# row = one bank transaction with a stable "Transaction ID" column) and writes
# back to the Category / Categorized By / Categorized Date columns. The AI's
# allowed category enum is read live from the Categories tab on every run.
# TRANSACTIONS_SHEET_ID is required to enable the feature; tab names default
# to "Transactions" and "Categories". Cron defaults to 8am UTC.
TRANSACTIONS_SHEET_ID=
TRANSACTIONS_TAB=
CATEGORIES_TAB=
TRANSACTION_TRIAGE_CRON_ENABLED=
TRANSACTION_TRIAGE_CRON_SCHEDULE=
TRANSACTION_TRIAGE_CRON_LIMIT=

# Nightly pg_dump → R2 (Cloudflare R2 is S3-compatible). Provide either
# R2_ENDPOINT (the S3 endpoint URL Cloudflare hands you, e.g.
# https://<acct>.r2.cloudflarestorage.com or a jurisdictional one) OR
# R2_ACCOUNT_ID (we'll build the default endpoint from it). The other three vars
# are always required; if anything is missing the cron logs an error and does
# not schedule. Default schedule is 3:15am UTC. The Dockerfile installs
# postgresql-client so `pg_dump` is available in the runtime image.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_CRON_SCHEDULE=

# Nightly GitHub source-tree snapshot → R2 (the repo as a gzipped tarball,
# pulled via the GitHub tarball API). Requires GITHUB_TOKEN (PAT with
# contents:read) and GITHUB_BACKUP_REPO ("owner/repo"). Default ref is "main",
# default schedule is 3:20am UTC (just after the DB dump at 3:15).
GITHUB_TOKEN=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_REF=
GITHUB_BACKUP_CRON_SCHEDULE=

# Web UI + JSON API auth. Default ON — startup fails loudly unless UI_PASSWORD
# (min 8 chars) and SESSION_SECRET (min 32 chars) are set. Set
# UI_AUTH_ENABLED=false (or 0) to disable for local testing.
UI_AUTH_ENABLED=
UI_PASSWORD=
SESSION_SECRET=

# Trello "Today list" auto-reorder. API key from https://trello.com/app-key,
# token via the authorize URL on that same page. After setting key+token,
# hit `GET /trello/discover` (or run `npm run trello:setup` locally) to print
# your boards/lists/custom-fields IDs, then populate the remaining vars.
# The daily/weekdays/weekends fields are Trello *Custom Fields* (checkbox
# type), not labels — provide their field IDs. Default cron schedule fires
# at 11:00 UTC = 06:00 ET.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_WAITING_LIST_ID=
TRELLO_TODAY_LIST_ID=
TRELLO_DAILY_FIELD_ID=
TRELLO_WEEKDAYS_FIELD_ID=
TRELLO_WEEKENDS_FIELD_ID=
TRELLO_REORDER_CRON_ENABLED=
TRELLO_REORDER_CRON_SCHEDULE=

# Timezone in which all *_CRON_SCHEDULE entries are interpreted. Defaults to
# America/New_York; "0 5 * * *" then means 5am ET year-round (DST-safe).
CRON_TZ=
