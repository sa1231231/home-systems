# Port the HTTP server binds to. Railway injects PORT automatically; defaults to 3000 locally.
PORT=3000

# Postgres connection string.
# - On Railway: set as ${{Postgres.DATABASE_URL}} (private network, *.railway.internal).
# - Locally: copy the Postgres "Public Networking" URL from Railway → Postgres service → Variables
#   (DATABASE_PUBLIC_URL). Required for `npm run db:push` from your laptop.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Anthropic API key. Optional locally — the /ai-calls endpoints and the
# classify() wrapper return / throw `MissingAnthropicKeyError` (HTTP 503)
# until set. Required for any Tier 3 classification.
ANTHROPIC_API_KEY=

# Google OAuth + CRM Sheet (Phase 1b).
# All four are optional locally — endpoints under /contacts return 503 until
# they're set. See docs/development.md → "Google OAuth one-time setup" for
# how to obtain GOOGLE_OAUTH_REFRESH_TOKEN via `npm run auth:google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
CRM_SHEET_ID=

# Nightly contacts sync (Google Contacts → CRM Sheet).
# Default schedule is 7am UTC = 3am ET. Set ENABLED=true in Railway to turn
# on; leave unset locally so dev doesn't fire at 3am. Schedule uses standard
# 5-field cron syntax in UTC.
CONTACTS_SYNC_CRON_ENABLED=
CONTACTS_SYNC_CRON_SCHEDULE=

# Daily Gmail triage. Each run pulls up to LIMIT inbox emails from the last
# day (skipping promotions/social/updates), matches rules first, falls
# through to AI classification for the residual. Default 7am UTC.
EMAIL_TRIAGE_CRON_ENABLED=
EMAIL_TRIAGE_CRON_SCHEDULE=
EMAIL_TRIAGE_CRON_LIMIT=

# Nightly pg_dump → R2 (Cloudflare R2 is S3-compatible). All four R2_* vars are
# required when BACKUP_CRON_ENABLED=true; otherwise the cron logs a warning and
# does not schedule. Default schedule is 3:15am UTC. The Dockerfile installs
# postgresql-client so `pg_dump` is available in the runtime image.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_CRON_ENABLED=
BACKUP_CRON_SCHEDULE=
