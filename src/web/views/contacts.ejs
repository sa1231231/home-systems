<%- include("partials/_header", { title: "Contacts sync — home-systems", tab: "contacts", flash: locals.flash }) %>

<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
  <h2 style="margin: 0;">Contacts sync</h2>
  <div class="spacer" style="flex: 1;"></div>
  <% if (locals.sheetUrl) { %>
    <a
      href="<%= sheetUrl %>"
      target="_blank"
      rel="noopener noreferrer"
      style="padding: 6px 14px; background: #fff; color: var(--fg); border: 1px solid var(--border); border-radius: 3px; text-decoration: none; font-size: 13px;"
    >Open sheet ↗</a>
  <% } %>
  <form
    hx-post="/ui/contacts/sync"
    hx-target="#sync-result"
    hx-swap="innerHTML"
    hx-disabled-elt="find button"
    hx-indicator="#sync-indicator"
  >
    <button type="submit" style="padding: 6px 14px; background: var(--accent); color: #fff; border: 1px solid var(--accent); border-radius: 3px; cursor: pointer;">
      Run sync now
    </button>
    <span id="sync-indicator" class="htmx-indicator muted" style="margin-left: 8px; font-size: 12px;">working…</span>
  </form>
</div>
<style>.htmx-indicator{opacity:0;transition:opacity .2s}.htmx-request .htmx-indicator,.htmx-request.htmx-indicator{opacity:1}</style>
<%- include("partials/_cron-banner", { cron }) %>
<%- include("partials/_triage-status", { run: locals.run, statusUrl: "/ui/contacts/triage-status" }) %>
<div id="sync-result"></div>

<%- include("partials/_rules-section", {
  rules,
  description: "Contacts sync is currently fully deterministic — there are no AI classifications and no rules to maintain yet. This panel is here for when contact tagging/grouping rules graduate from approvals later.",
  emptyText: "No contact rules yet.",
  sectionId: "contact-rules",
}) %>

<section style="margin-bottom: 32px;">
  <% const noGroupCount = (audit && audit.noGroup) ? audit.noGroup.length : 0; %>
  <h3 style="margin: 0 0 6px;">
    Pending review
    <span class="muted" style="font-weight: normal; font-size: 13px;">
      (<%= noGroupCount %> without group<% if (pending.length) { %> · <%= pending.length %> queued refresh/ambiguous<% } %>)
    </span>
  </h3>
  <p class="muted" style="margin: 0 0 8px; font-size: 13px;">
    Contacts with no value in <code>groups</code> are pending review. Assign a group in the sheet
    (values come from the <code>groups</code> tab) and they drop off this list. Tag a contact
    <code>DNDB</code> (do not do business) to exempt them — they stay group-less but won't show here.
  </p>
  <% if (audit && audit.noGroup && audit.noGroup.length > 0) { %>
    <% const groups = (locals.availableGroups || []); %>
    <table>
      <thead>
        <tr>
          <th style="width: 60px;">Row</th>
          <th>Full name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Company</th>
          <th style="width: 280px;">Assign group</th>
        </tr>
      </thead>
      <tbody>
        <% audit.noGroup.forEach((n) => { %>
          <tr id="audit-row-nogroup-<%= n.rowIndex %>">
            <td class="muted"><%= n.rowIndex %></td>
            <td><%= n.fullName %></td>
            <td class="muted" style="font-size: 12px;"><%= n.primaryEmail || '—' %></td>
            <td class="muted" style="font-size: 12px;"><%= n.primaryPhone || '—' %></td>
            <td class="muted" style="font-size: 12px;"><%= n.company || '—' %></td>
            <td>
              <% if (groups.length > 0) { %>
                <form
                  hx-post="/ui/contacts/assign-group/<%= n.rowIndex %>"
                  hx-target="#audit-row-nogroup-<%= n.rowIndex %>"
                  hx-swap="outerHTML"
                  hx-disabled-elt="find button"
                  style="display: flex; gap: 6px; align-items: center;"
                >
                  <input type="hidden" name="expected_full_name" value="<%= n.fullName %>" />
                  <select name="group" required style="flex: 1; padding: 4px 6px; border: 1px solid var(--border); border-radius: 3px; font-size: 12px; background: #fff;">
                    <option value="" disabled selected>— pick group —</option>
                    <% groups.forEach((g) => { %>
                      <option value="<%= g %>"><%= g %></option>
                    <% }); %>
                  </select>
                  <button type="submit" style="padding: 4px 10px; background: var(--accent); color: #fff; border: 1px solid var(--accent); border-radius: 3px; cursor: pointer; font-size: 12px;">
                    Assign
                  </button>
                </form>
              <% } else { %>
                <span class="muted" style="font-size: 12px;">No groups loaded.</span>
                <% if (locals.sheetUrl) { %>
                  <a href="<%= sheetUrl %>" target="_blank" rel="noopener noreferrer" style="font-size: 12px;">Open in sheet ↗</a>
                <% } %>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p class="muted">Every contact has a group assigned.</p>
  <% } %>

  <% if (pending.length > 0) { %>
    <h4 style="margin: 18px 0 4px;">Queue (refresh / ambiguous)</h4>
    <div id="bulk-toolbar" style="display: none; position: sticky; top: 0; z-index: 10; background: #fffbe6; border: 1px solid #b35a00; padding: 8px 12px; margin-bottom: 8px; border-radius: 4px; align-items: center; gap: 10px;">
      <span><strong id="bulk-count">0</strong> selected</span>
      <span class="spacer" style="flex: 1;"></span>
      <button type="button" id="bulk-select-all" style="padding: 4px 12px; background: #fff; border: 1px solid var(--border); border-radius: 3px; cursor: pointer; font-size: 12px;">Select all on page</button>
      <button type="button" id="bulk-clear" style="padding: 4px 12px; background: #fff; border: 1px solid var(--border); border-radius: 3px; cursor: pointer; font-size: 12px;">Clear</button>
      <form id="bulk-approve-form" hx-post="/ui/needs-review/bulk/approve" hx-target="#bulk-flash" hx-swap="innerHTML" hx-confirm="Approve all selected reviews?" style="display: inline;">
        <input type="hidden" name="ids" id="bulk-approve-ids" />
        <button type="submit" style="padding: 4px 12px; background: #e3f5e9; border: 1px solid #128a3e; color: #128a3e; border-radius: 3px; cursor: pointer;">Approve selected</button>
      </form>
      <form id="bulk-reject-form" hx-post="/ui/needs-review/bulk/reject" hx-target="#bulk-flash" hx-swap="innerHTML" hx-confirm="Skip all selected reviews?" style="display: inline;">
        <input type="hidden" name="ids" id="bulk-reject-ids" />
        <button type="submit" style="padding: 4px 12px; background: #fff; border: 1px solid var(--border); border-radius: 3px; cursor: pointer;">Skip selected</button>
      </form>
    </div>
    <div id="bulk-flash"></div>
    <table style="table-layout: fixed; width: 100%;">
      <colgroup>
        <col style="width: 36px;" />
        <col style="width: 110px;" />
        <col style="width: 220px;" />
        <col />
        <col style="width: 90px;" />
        <col style="width: 180px;" />
      </colgroup>
      <thead>
        <tr>
          <th style="text-align: center;"><input type="checkbox" id="bulk-header-toggle" title="Select all on page" /></th>
          <th>When (UTC)</th>
          <th>Contact</th>
          <th>Change</th>
          <th>Status</th>
          <th>Decide</th>
        </tr>
      </thead>
      <tbody>
        <% pending.forEach((entry) => { %>
          <%- include("partials/_contact-review-row", {
            entry,
            applyOutcome: null,
            matchedRows: (locals.matchedRowsByEntryId && locals.matchedRowsByEntryId[entry.id]) || null,
            mergePreview: (locals.mergePreviewByEntryId && locals.mergePreviewByEntryId[entry.id]) || null,
            includeBulkCheckbox: true,
          }) %>
        <% }); %>
      </tbody>
    </table>
    <script>
      (function () {
        var checkboxes = function () { return document.querySelectorAll('input.bulk-select'); };
        var toolbar = document.getElementById('bulk-toolbar');
        var countEl = document.getElementById('bulk-count');
        var lastChecked = null;
        function selectedIds() {
          var out = [];
          checkboxes().forEach(function (cb) { if (cb.checked) out.push(cb.dataset.reviewId); });
          return out;
        }
        function updateToolbar() {
          var ids = selectedIds();
          countEl.textContent = ids.length;
          toolbar.style.display = ids.length > 0 ? 'flex' : 'none';
          document.getElementById('bulk-approve-ids').value = ids.join(',');
          document.getElementById('bulk-reject-ids').value = ids.join(',');
        }
        function onCheckboxClick(e, cb) {
          if (e.shiftKey && lastChecked && lastChecked !== cb) {
            var all = Array.prototype.slice.call(checkboxes());
            var a = all.indexOf(lastChecked);
            var b = all.indexOf(cb);
            if (a > -1 && b > -1) {
              var lo = Math.min(a, b), hi = Math.max(a, b);
              for (var i = lo; i <= hi; i++) all[i].checked = cb.checked;
            }
          }
          lastChecked = cb;
          updateToolbar();
        }
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.matches && t.matches('input.bulk-select')) onCheckboxClick(e, t);
        });
        var headerToggle = document.getElementById('bulk-header-toggle');
        headerToggle.addEventListener('change', function () {
          checkboxes().forEach(function (cb) { cb.checked = headerToggle.checked; });
          updateToolbar();
        });
        document.getElementById('bulk-select-all').addEventListener('click', function () {
          checkboxes().forEach(function (cb) { cb.checked = true; });
          headerToggle.checked = true;
          updateToolbar();
        });
        document.getElementById('bulk-clear').addEventListener('click', function () {
          checkboxes().forEach(function (cb) { cb.checked = false; });
          headerToggle.checked = false;
          updateToolbar();
        });
      })();
    </script>
  <% } %>
</section>

<% if (audit) { %>
<section style="margin-bottom: 32px;">
  <h3 style="margin: 0 0 6px;">
    Sheet audit
    <span class="muted" style="font-weight: normal; font-size: 13px;">
      <%= audit.totalRows %> rows ·
      <%= audit.orphans.length %> orphan dupe<%= audit.orphans.length === 1 ? '' : 's' %>,
      <%= audit.emptyRows.length %> empty,
      <%= audit.nameOnly.length %> name-only,
      <%= audit.emailDuplicates.length %> email dup-cluster<%= audit.emailDuplicates.length === 1 ? '' : 's' %>,
      <%= audit.phoneDuplicates.length %> phone dup-cluster<%= audit.phoneDuplicates.length === 1 ? '' : 's' %>
    </span>
  </h3>
  <p class="muted" style="margin: 0 0 8px;">
    Orphans are rows with a name but no <code>google_resource_name</code> where another row with the same
    name <em>does</em> have one — leftovers from earlier broken syncs that quietly poison the dedupe loop.
    Deleting them is logged to the changelog.
  </p>
  <% if (audit.orphans.length === 0 && audit.emptyRows.length === 0 && audit.nameOnly.length === 0) { %>
    <p class="muted">Sheet looks clean. Nothing to flag.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th style="width: 60px;">Row</th>
          <th>Full name</th>
          <th style="width: 130px;">Issue</th>
          <th>Canonical row</th>
          <th style="width: 110px;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% audit.orphans.forEach((o) => { %>
          <tr id="audit-row-orphan-<%= o.rowIndex %>">
            <td class="muted"><%= o.rowIndex %></td>
            <td><%= o.fullName %></td>
            <td><span class="pill rejected">orphan dupe</span></td>
            <td class="muted">→ row <%= o.canonicalRowIndex %></td>
            <td>
              <button
                hx-post="/ui/contacts/delete-orphan/<%= o.rowIndex %>"
                hx-target="#audit-row-orphan-<%= o.rowIndex %>"
                hx-swap="outerHTML"
                hx-confirm="Delete row <%= o.rowIndex %> ('<%= o.fullName %>')? The canonical row <%= o.canonicalRowIndex %> stays."
                style="padding: 4px 10px; border: 1px solid var(--danger); color: var(--danger); background: #fff; border-radius: 3px; cursor: pointer;"
              >Delete</button>
            </td>
          </tr>
        <% }); %>
        <% audit.emptyRows.forEach((e) => { %>
          <tr id="audit-row-empty-<%= e.rowIndex %>">
            <td class="muted"><%= e.rowIndex %></td>
            <td class="muted">(empty)</td>
            <td><span class="pill rejected">empty row</span></td>
            <td class="muted">—</td>
            <td>
              <button
                hx-post="/ui/contacts/delete-orphan/<%= e.rowIndex %>"
                hx-target="#audit-row-empty-<%= e.rowIndex %>"
                hx-swap="outerHTML"
                hx-confirm="Delete empty row <%= e.rowIndex %>?"
                style="padding: 4px 10px; border: 1px solid var(--danger); color: var(--danger); background: #fff; border-radius: 3px; cursor: pointer;"
              >Delete</button>
            </td>
          </tr>
        <% }); %>
        <% audit.nameOnly.forEach((n) => { %>
          <tr id="audit-row-nameonly-<%= n.rowIndex %>">
            <td class="muted"><%= n.rowIndex %></td>
            <td><%= n.fullName %></td>
            <td><span class="pill pending">name only</span></td>
            <td class="muted">no match (might be intentional)</td>
            <td>
              <button
                hx-post="/ui/contacts/delete-orphan/<%= n.rowIndex %>"
                hx-target="#audit-row-nameonly-<%= n.rowIndex %>"
                hx-swap="outerHTML"
                hx-confirm="Delete row <%= n.rowIndex %> ('<%= n.fullName %>')? This row has no Google contact backing — it may be a manual entry you actually want."
                style="padding: 4px 10px; border: 1px solid var(--border); background: #fff; border-radius: 3px; cursor: pointer;"
              >Delete</button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <%
    const dupSections = [
      { title: "Email duplicates", groups: audit.emailDupViews, total: audit.emailDuplicates.length, label: "email" },
      { title: "Phone duplicates", groups: audit.phoneDupViews, total: audit.phoneDuplicates.length, label: "phone" },
    ];
  %>
  <% dupSections.forEach((sec) => { %>
    <% if (sec.groups.length > 0) { %>
      <h4 style="margin: 18px 0 4px;">
        <%= sec.title %>
        <span class="muted" style="font-weight: normal; font-size: 12px;">
          (<%= sec.total %> cluster<%= sec.total === 1 ? '' : 's' %><%= sec.total > sec.groups.length ? `, showing top ${sec.groups.length}` : '' %>)
        </span>
      </h4>
      <p class="muted" style="margin: 0 0 8px; font-size: 12px;">Two-or-more rows share a <%= sec.label %>. Decide which row is the keeper; Delete the rest.</p>
      <table>
        <thead>
          <tr>
            <th style="width: 200px;">Shared <%= sec.label %></th>
            <th style="width: 50px;">Row</th>
            <th>Name</th>
            <th>Emails</th>
            <th>Phones</th>
            <th>Company</th>
            <th style="width: 90px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% sec.groups.forEach((g, gi) => { %>
            <% g.rows.forEach((r, ri) => { %>
              <tr id="audit-row-<%= sec.label %>-<%= gi %>-<%= r.rowIndex %>" style="<%= ri === 0 ? 'border-top: 2px solid var(--border);' : '' %>">
                <% if (ri === 0) { %>
                  <td rowspan="<%= g.rows.length %>" style="vertical-align: top; font-family: monospace; font-size: 12px;"><%= g.value %></td>
                <% } %>
                <td class="muted"><%= r.rowIndex %></td>
                <td><%= r.name %></td>
                <td class="muted" style="font-size: 12px;"><%= r.emails || '—' %></td>
                <td class="muted" style="font-size: 12px;"><%= r.phones || '—' %></td>
                <td class="muted" style="font-size: 12px;"><%= r.company || '—' %></td>
                <td>
                  <button
                    hx-post="/ui/contacts/delete-orphan/<%= r.rowIndex %>"
                    hx-target="#audit-row-<%= sec.label %>-<%= gi %>-<%= r.rowIndex %>"
                    hx-swap="outerHTML"
                    hx-confirm="Delete row <%= r.rowIndex %> ('<%= r.name %>')?"
                    style="padding: 4px 10px; border: 1px solid var(--danger); color: var(--danger); background: #fff; border-radius: 3px; cursor: pointer;"
                  >Delete</button>
                </td>
              </tr>
            <% }); %>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  <% }); %>
</section>
<% } %>

<%- include("partials/_activity-section", { sessionGroups, label: "Contacts" }) %>

<%- include("partials/_footer") %>
