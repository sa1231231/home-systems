<%- include("partials/_header", { title: "Trello — home-systems", tab: "trello", flash: locals.flash }) %>

<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
  <h2 style="margin: 0;">Trello — Today ordering</h2>
  <div class="spacer" style="flex: 1;"></div>
  <% if (!notConfigured) { %>
    <form
      hx-post="/ui/trello/reorder"
      hx-target="#reorder-result"
      hx-swap="innerHTML"
      hx-disabled-elt="find button"
      hx-indicator="#reorder-indicator"
    >
      <button type="submit" style="padding: 6px 14px; background: var(--accent); color: #fff; border: 1px solid var(--accent); border-radius: 3px; cursor: pointer;">
        Reorder now
      </button>
      <span id="reorder-indicator" class="htmx-indicator muted" style="margin-left: 8px; font-size: 12px;">working…</span>
    </form>
  <% } %>
</div>
<style>.htmx-indicator{opacity:0;transition:opacity .2s}.htmx-request .htmx-indicator,.htmx-request.htmx-indicator{opacity:1}</style>

<% if (notConfigured) { %>
  <div class="flash err" style="margin-bottom: 12px;">
    Trello isn't configured. Set <code>TRELLO_API_KEY</code>, <code>TRELLO_TOKEN</code>,
    <code>TRELLO_BOARD_ID</code>, <code>TRELLO_WAITING_LIST_ID</code>, <code>TRELLO_TODAY_LIST_ID</code>.
  </div>
<% } else { %>
  <%- include("partials/_cron-banner", { cron }) %>
  <%- include("partials/_triage-status", { run: locals.run, statusUrl: "/ui/trello/triage-status" }) %>
  <div id="reorder-result"></div>

  <%- include("partials/_activity-section", { sessionGroups, label: "Trello" }) %>
<% } %>

<%- include("partials/_footer") %>
