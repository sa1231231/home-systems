<%- include("partials/_header", { title: "Gmail triage — home-systems", tab: "gmail", flash: locals.flash }) %>

<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
  <h2 style="margin: 0;">Gmail triage</h2>
  <div class="spacer" style="flex: 1;"></div>
  <form
    hx-post="/ui/gmail/triage"
    hx-target="#triage-result"
    hx-swap="innerHTML"
    hx-disabled-elt="find button"
    hx-indicator="#triage-indicator"
  >
    <span class="muted" style="font-size: 12px; margin-right: 8px;">scans the last 72h across all accounts</span>
    <button type="submit" style="padding: 6px 14px; background: var(--accent); color: #fff; border: 1px solid var(--accent); border-radius: 3px; cursor: pointer;">
      Run triage now
    </button>
    <span id="triage-indicator" class="htmx-indicator muted" style="margin-left: 8px; font-size: 12px;">working…</span>
  </form>
</div>
<style>.htmx-indicator{opacity:0;transition:opacity .2s}.htmx-request .htmx-indicator,.htmx-request.htmx-indicator{opacity:1}</style>
<%- include("partials/_cron-banner", { cron }) %>
<%- include("partials/_triage-status", { run: locals.run, statusUrl: "/ui/gmail/triage-status" }) %>
<div id="triage-result"></div>

<% const multi = accountGroups.length > 1; %>

<% if (multi) { %>
  <div class="acct-tabs" role="tablist" style="display: flex; gap: 4px; flex-wrap: nowrap; overflow-x: auto; margin-bottom: 18px; border-bottom: 1px solid var(--border);">
    <% accountGroups.forEach((g, i) => { %>
      <button
        type="button"
        data-acct-tab="<%= i %>"
        data-acct-name="<%= g.account %>"
        draggable="true"
        title="Click to switch, drag to reorder"
        onclick="selectAcctTab(<%= i %>)"
        style="flex: 0 0 auto; white-space: nowrap; padding: 6px 12px; border: 1px solid var(--border); border-bottom: none; border-radius: 4px 4px 0 0; cursor: pointer; font: inherit; margin-bottom: -1px; background: <%= i === 0 ? '#fff' : '#f4f4f4' %>; font-weight: <%= i === 0 ? '600' : 'normal' %>;"
      >
        <%= g.account %>
        <span class="muted" style="font-size: 11px; font-weight: normal;">(<%= g.rules.length %>r · <%= g.pending.length %>p · <%= g.recent.length %>a)</span>
      </button>
    <% }); %>
  </div>
<% } %>

<% accountGroups.forEach((g, i) => { %>
  <div data-acct-panel="<%= i %>" <% if (multi && i !== 0) { %>style="display: none;"<% } %>>
    <section style="margin-bottom: 32px;">
      <h3 style="margin: 0 0 6px;">Pending review <span class="muted" style="font-weight: normal; font-size: 13px;">(<%= g.pending.length %>)</span></h3>
      <p class="muted" style="margin: 0 0 8px;">AI classifications waiting for your decision. Approve applies the action to Gmail; <em>promote</em> also creates a deterministic rule so future matches skip the AI.</p>
      <% if (g.pending.length === 0) { %>
        <p class="muted">No emails currently waiting for review.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th style="width: 130px;">When (UTC)</th>
              <th>Email</th>
              <th style="width: 130px;">Category</th>
              <th style="width: 140px;">Status</th>
              <th style="width: 320px;">Decide</th>
            </tr>
          </thead>
          <tbody>
            <% g.pending.forEach((entry) => { %>
              <%- include("partials/_review-row", { entry, applyOutcome: null }) %>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section style="margin-bottom: 32px;">
      <h3 style="margin: 0 0 6px;">Recent activity <span class="muted" style="font-weight: normal; font-size: 13px;">(<%= g.recent.length %>)</span></h3>
      <p class="muted" style="margin: 0 0 8px;">Emails recently classified by a rule. If the rule got one wrong, click <em>Wrong call</em> — the AI will propose a more specific exception rule based on the reason you give. The original Gmail action will be reversed.</p>
      <% if (g.recent.length === 0) { %>
        <p class="muted">No rule-fired emails yet — run triage to populate.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th style="width: 130px;">When (UTC)</th>
              <th>Email</th>
              <th style="width: 200px;">Rule that fired</th>
              <th style="width: 380px;">Correct</th>
            </tr>
          </thead>
          <tbody>
            <% g.recent.forEach((entry) => { %>
              <%- include("partials/_rule-fired-row", { entry }) %>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <%- include("partials/_rules-section", {
      rules: g.rules,
      description: "Deterministic matches run first; emails matching a rule never call the AI.",
      emptyText: "No rules yet. Approve a review above to create the first one.",
      sectionId: "email-rules-" + i,
      open: false,
    }) %>
  </div>
<% }); %>

<% if (multi) { %>
<script>
function selectAcctTab(i) {
  document.querySelectorAll('[data-acct-panel]').forEach(function (p) {
    p.style.display = p.getAttribute('data-acct-panel') === String(i) ? '' : 'none';
  });
  document.querySelectorAll('[data-acct-tab]').forEach(function (t) {
    var on = t.getAttribute('data-acct-tab') === String(i);
    t.style.background = on ? '#fff' : '#f4f4f4';
    t.style.fontWeight = on ? '600' : 'normal';
  });
}

(function () {
  var KEY = 'home-systems:gmail-account-order';
  var container = document.querySelector('.acct-tabs');
  if (!container) return;

  function getTabs() {
    return Array.prototype.slice.call(container.querySelectorAll('[data-acct-tab]'));
  }
  function saveOrder() {
    var order = getTabs().map(function (el) { return el.getAttribute('data-acct-name'); });
    try { localStorage.setItem(KEY, JSON.stringify(order)); } catch (e) {}
  }
  function applySavedOrder() {
    var saved;
    try { saved = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { saved = []; }
    if (!saved || !saved.length) return;
    var byName = {};
    getTabs().forEach(function (el) { byName[el.getAttribute('data-acct-name')] = el; });
    saved.forEach(function (name) {
      var el = byName[name];
      if (el) { container.appendChild(el); delete byName[name]; }
    });
  }

  applySavedOrder();

  var dragged = null;
  getTabs().forEach(function (tab) {
    tab.addEventListener('dragstart', function (e) {
      dragged = tab;
      tab.style.opacity = '0.4';
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = 'move';
        try { e.dataTransfer.setData('text/plain', tab.getAttribute('data-acct-name') || ''); } catch (err) {}
      }
    });
    tab.addEventListener('dragend', function () {
      if (dragged) { dragged.style.opacity = ''; dragged = null; }
      saveOrder();
    });
    tab.addEventListener('dragover', function (e) {
      if (!dragged || dragged === tab) return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      var rect = tab.getBoundingClientRect();
      var after = e.clientX > rect.left + rect.width / 2;
      container.insertBefore(dragged, after ? tab.nextSibling : tab);
    });
    tab.addEventListener('drop', function (e) { e.preventDefault(); });
  });
})();
</script>
<% } %>

<%- include("partials/_activity-section", { sessionGroups, label: "Gmail" }) %>

<%- include("partials/_footer") %>
