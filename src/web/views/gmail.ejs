<%- include("partials/_header", { title: "Gmail triage — home-systems", tab: "gmail", flash: locals.flash }) %>

<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
  <h2 style="margin: 0;">Gmail triage</h2>
  <div class="spacer" style="flex: 1;"></div>
  <form
    hx-post="/ui/gmail/triage"
    hx-target="#triage-result"
    hx-swap="innerHTML"
    hx-disabled-elt="find button"
    hx-indicator="#triage-indicator"
  >
    <input type="hidden" name="limit" value="10" />
    <button type="submit" style="padding: 6px 14px; background: var(--accent); color: #fff; border: 1px solid var(--accent); border-radius: 3px; cursor: pointer;">
      Run triage now (10)
    </button>
    <span id="triage-indicator" class="htmx-indicator muted" style="margin-left: 8px; font-size: 12px;">working…</span>
  </form>
</div>
<style>.htmx-indicator{opacity:0;transition:opacity .2s}.htmx-request .htmx-indicator,.htmx-request.htmx-indicator{opacity:1}</style>
<div id="triage-result"></div>

<section style="margin-bottom: 32px;">
  <h3 style="margin: 0 0 6px;">Rules <span class="muted" style="font-weight: normal; font-size: 13px;">(<%= rules.length %>)</span></h3>
  <p class="muted" style="margin: 0 0 8px;">Deterministic matches run first; emails matching a rule never call the AI.</p>
  <% if (rules.length === 0) { %>
    <p class="muted">No rules yet. Approve a review below with <em>promote</em> ticked to create the first one.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th style="width: 80px;">Priority</th>
          <th>Match</th>
          <th>Action</th>
          <th style="width: 140px;">Source</th>
          <th style="width: 100px;">Created</th>
          <th style="width: 90px;"></th>
        </tr>
      </thead>
      <tbody>
        <% rules.forEach((rule) => { %>
          <%- include("partials/_rule-row", { rule }) %>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<section>
  <h3 style="margin: 0 0 6px;">Pending review <span class="muted" style="font-weight: normal; font-size: 13px;">(<%= pending.length %>)</span></h3>
  <p class="muted" style="margin: 0 0 8px;">AI classifications waiting for your decision. Approve applies the action to Gmail; <em>promote</em> also creates a deterministic rule so future matches skip the AI.</p>
  <% if (pending.length === 0) { %>
    <p class="muted">No emails currently waiting for review.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th style="width: 130px;">When (UTC)</th>
          <th>Email</th>
          <th style="width: 130px;">Category</th>
          <th style="width: 140px;">Status</th>
          <th style="width: 320px;">Decide</th>
        </tr>
      </thead>
      <tbody>
        <% pending.forEach((entry) => { %>
          <%- include("partials/_review-row", { entry, applyOutcome: null }) %>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include("partials/_footer") %>
