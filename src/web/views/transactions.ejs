<%- include("partials/_header", { title: "Transactions — home-systems", tab: "transactions", flash: locals.flash }) %>

<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
  <h2 style="margin: 0;">Transaction categorization</h2>
  <div class="spacer" style="flex: 1;"></div>
  <% if (locals.sheetUrl) { %>
    <a
      href="<%= sheetUrl %>"
      target="_blank"
      rel="noopener noreferrer"
      style="padding: 6px 14px; background: #fff; color: var(--fg); border: 1px solid var(--border); border-radius: 3px; text-decoration: none; font-size: 13px;"
    >Open sheet ↗</a>
  <% } %>
  <form
    hx-post="/ui/transactions/triage"
    hx-target="#triage-result"
    hx-swap="innerHTML"
    hx-disabled-elt="find button"
    hx-indicator="#triage-indicator"
  >
    <button type="submit" style="padding: 6px 14px; background: var(--accent); color: #fff; border: 1px solid var(--accent); border-radius: 3px; cursor: pointer;">
      Run triage now
    </button>
    <span id="triage-indicator" class="htmx-indicator muted" style="margin-left: 8px; font-size: 12px;">working…</span>
  </form>
</div>
<style>.htmx-indicator{opacity:0;transition:opacity .2s}.htmx-request .htmx-indicator,.htmx-request.htmx-indicator{opacity:1}</style>
<%- include("partials/_cron-banner", { cron }) %>
<%- include("partials/_triage-status", { run: locals.run, statusUrl: "/ui/transactions/triage-status" }) %>
<div id="triage-result"></div>

<% if (locals.warning) { %>
  <div class="flash err" style="margin-bottom: 16px;"><%= warning %></div>
<% } %>

<section>
  <h3 style="margin: 0 0 6px;">Pending review <span class="muted" style="font-weight: normal; font-size: 13px;">(<%= pending.length %>)</span></h3>
  <p class="muted" style="margin: 0 0 8px;">
    AI category proposals waiting for your decision. Approving writes the category back to the sheet
    and promotes a rule so future identical transactions skip the AI.
    <% if (categories.length > 0) { %>
      <span style="margin-left: 8px;">Canonical categories: <%= categories.length %>.</span>
    <% } %>
  </p>
  <% if (pending.length === 0) { %>
    <p class="muted">No transactions currently waiting for review.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th style="width: 100px;">Date</th>
          <th>Transaction</th>
          <th style="width: 110px;">Amount</th>
          <th style="width: 220px;">AI proposal</th>
          <th style="width: 140px;">Status</th>
          <th style="width: 320px;">Decide</th>
        </tr>
      </thead>
      <tbody>
        <% pending.forEach((entry) => { %>
          <%- include("partials/_transaction-review-row", { entry, applyOutcome: null, categories }) %>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include("partials/_rules-section", {
  rules,
  description: "Deterministic matches run first; transactions matching a rule never call the AI.",
  emptyText: "No rules yet. Approve a review below to create the first one.",
  sectionId: "transaction-rules",
}) %>

<%- include("partials/_situational-section", { situationalRules }) %>

<%- include("partials/_cleanup-section", { consolidations }) %>

<%- include("partials/_activity-section", { sessionGroups, label: "Transactions" }) %>

<%- include("partials/_footer") %>
